PROJECT_NAME="life-rpg-backend"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=life_rpg
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_rpg"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# JWT Authentication Config (for future phase)
SECRET_KEY="change_this_to_a_secure_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
